<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WarpforgeOpenServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Editable player state, title data and canned responses; kept next to the source, not copied to bin -->
    <None Include="data\**" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
